# ---------------------------------------------------------------------------
# Agentic IAM POC - environment
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000

# --- PostgreSQL (docker-compose publishes on 5433 to avoid clashing with a
#     local postgres on 5432) ---
POSTGRES_USER=iam
POSTGRES_PASSWORD=iam
POSTGRES_DB=agentic_iam
DATABASE_URL=postgresql+psycopg://iam:iam@localhost:5433/agentic_iam

# --- Redis ---
# REQUIRED FROM PHASE 10. It is the shared counter behind rate limiting.
# (Phase 9 recorded Redis as an unused-but-mandatory dependency; this is what
# now uses it.) A counter in process memory limits ONE worker and says
# nothing about that, so in production RATELIMIT_REDIS_POLICY=fail_closed
# makes an unreachable Redis an API outage rather than a silently unenforced
# limit.
REDIS_URL=redis://localhost:6380/0

# --- Identity ---
DID_METHOD=poc
ORGANIZATION_DID=did:poc:organization:bank-demo
KEYSTORE_BACKEND=encrypted_file
KEYSTORE_DIR=./.keystore
# Master key for the encrypted-file keystore.
#
# DELIBERATELY LEFT UNSET. Unset means the application falls back to its
# documented development default (DEV_MASTER_KEY in
# backend/app/core/config.py), which is the readable placeholder
# "dev-only-master-key-32-bytes-long!!" -- not a credential. Everything runs
# out of the box.
#
# It used to be written here as the base64 of that phrase, and a secret
# scanner flagged it as a leaked high-entropy key. That was the correct call
# on the information available to it: nothing distinguishes a base64
# placeholder from a base64 key. Keeping placeholders READABLE is the fix.
#
# OUTSIDE DEVELOPMENT THIS MUST BE SET. The API refuses to start with the
# development default when ENV=production, and warns on every other start.
# Generate a real one with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#KEYSTORE_MASTER_KEY=

# --- Phase 8: MCP ---
# The MCP endpoint's canonical URI. This is its OAuth RESOURCE IDENTIFIER
# (RFC 8707), not just a convenience URL: it is the audience a token is bound
# to and the `resource` an MCP client sends. No fragment, no trailing slash --
# RFC 9728 and the MCP spec match it exactly, so a cosmetic difference here
# becomes an authentication failure later.
MCP_RESOURCE_URI=http://localhost:8000/mcp

# The audience an MCP access token must carry. KEEP THIS DIFFERENT FROM
# OIDC_AUDIENCE. If the MCP resource server and the human console API ever
# shared one audience, a token minted for a loan officer's browser session
# would open an agent's MCP session and vice versa -- exactly the
# cross-service token reuse the MCP authorization spec forbids. A test
# asserts they differ.
MCP_AUDIENCE=agentic-iam-mcp

# Origins permitted on the MCP endpoint (comma-separated). EMPTY MEANS NO
# CROSS-ORIGIN BROWSER CLIENT MAY CONNECT, which is the correct default for a
# service-to-service endpoint and is NOT the same as "allow anything". The
# transport spec requires Origin validation to prevent DNS rebinding.
MCP_ALLOWED_ORIGINS=

# How long an idle MCP session survives, in seconds.
MCP_SESSION_IDLE_SECONDS=900

# --- Phase 10: rate limiting ---
# Per-tier "requests,window_seconds". Tiers are resolved by path; see
# app/ratelimit/middleware.py. `auth` is tightest because credential and
# token endpoints are where guessing and replay happen.
RATELIMIT_ENABLED=true
RATELIMIT_AUTH=20,60
RATELIMIT_EXPENSIVE=60,60
RATELIMIT_MUTATION=120,60
RATELIMIT_READ=300,60

# What to do when Redis cannot be reached.
#   fail_closed      refuse the request. REQUIRED in production.
#   fail_open_local  count in process memory and WARN on every request.
#                    Single-instance development only -- across N workers it
#                    is an N-times-looser limit that still reports as
#                    enforced, which is why production refuses it.
RATELIMIT_REDIS_POLICY=fail_open_local

# Whose X-Forwarded-For to believe, as comma-separated CIDRs. EMPTY means
# believe nobody, which is correct without a proxy in front: a caller that
# can set its own forwarded address mints a fresh allowance every request.
# Behind a proxy this MUST be set, or the limiter keys on the proxy and
# treats the whole internet as one caller.
TRUSTED_PROXY_NETWORKS_RAW=

# --- Phase 10: CORS ---
# Was hardcoded in main.py. CORS is NOT authorization -- it restricts which
# BROWSER ORIGINS may read a response and does nothing about a direct HTTP
# call, which is why every sensitive route is guarded independently.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=authorization,content-type,mcp-session-id,mcp-protocol-version
# Phase 12: this ONE list now configures the IAM API, the ANS and all nine
# agent processes (they used to hard-code localhost). Every entry must be an
# exact origin (scheme://host[:port]); malformed entries refuse to start in
# every environment, and '*' is refused outright when ENV=production.

# --- Phase 12: tamper-evident audit trail ---
# The sealer chains committed audit events (app/audit/integrity.py) and signs
# checkpoints with a keystore key. Production refuses AUDIT_SEALER_ENABLED=false.
AUDIT_SEALER_ENABLED=true
AUDIT_SEAL_INTERVAL_SECONDS=2
AUDIT_CHECKPOINT_INTERVAL_SECONDS=30
AUDIT_VERIFY_INTERVAL_SECONDS=900
AUDIT_UNSEALED_GRACE_SECONDS=120
# Optional: a base64 Ed25519 checkpoint public key recorded out of band by an
# auditor. When set, it REPLACES trust in the keystore's key for verification.
AUDIT_PINNED_CHECKPOINT_KEY=

# --- Phase 10: presentation replay protection ---
# A verifier challenge is now recorded at issue, bound to its verifier,
# expiring and spendable exactly once -- closing a gap this codebase had
# documented since Phase 2.
CHALLENGE_TTL_SECONDS=300
CHALLENGE_REQUIRED=true

# --- PRODUCTION ---
# Setting ENV=production turns on checks the API refuses to start without:
#
#   * KEYSTORE_MASTER_KEY must not be the development default.
#   * OPA_URL, KEYCLOAK_BASE_URL, KEYCLOAK_ISSUER, MCP_RESOURCE_URI and
#     API_PUBLIC_URL must all be https. Each carries something an attacker in
#     the middle could forge -- a policy decision, a signing key, or a bearer
#     token -- and substituting the JWKS is the worst of them, because tokens
#     then verify honestly against the attacker's key.
#   * RATELIMIT_ENABLED must be true and RATELIMIT_REDIS_POLICY must be
#     fail_closed.
#   * CORS origins must be https and explicit; '*' is refused.
#   * AUDIT_SEALER_ENABLED must be true (Phase 12).
#
# There is no opt-out flag for either, by design. Neither is there one for
# AUTHORIZATION_FAIL_CLOSED, CONTROL_PLANE_AUTHENTICATION_REQUIRED,
# HITL_ENABLED, A2A_VERIFICATION_REQUIRED or MCP_AUTHENTICATION_REQUIRED: a
# switch that turns a security requirement into a no-op is a bypass with a
# configuration file in front of it.
#
# Read docs/PRODUCTION_DEPLOYMENT.md before deploying. The Phase 9 HIGH
# finding (an unauthenticated read API) was closed in Phase 10; TLS is still
# the operator's to provide, and the service refuses to start without it.

# --- LLM (Ollama) ---
# From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1

# --- Agent processes ---
IAM_API_URL=http://localhost:8000
AGENT_KEYSTORE_DIR=./.keystore-agents
