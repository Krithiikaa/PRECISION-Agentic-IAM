{
  "realm": "agentic-iam",
  "enabled": true,
  "displayName": "Agentic IAM (POC)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "IAM_ADMIN",
        "description": "Manages agent identities, credentials and policy. Does NOT approve loans."
      },
      {
        "name": "LOAN_OFFICER",
        "description": "Approves high-value loan decisions. Has NO authority over IAM."
      },
      {
        "name": "AUDITOR",
        "description": "Reads the audit trail. Approves nothing and changes nothing."
      },
      {
        "name": "PAYMENT_OFFICER",
        "description": "Approves agent-to-agent payment instructions (Phase 7). A DEDICATED role, deliberately not LOAN_OFFICER: approving a lending decision and approving the movement of money are different authorities, and neither is a superset of the other. Has NO authority over IAM and cannot approve a loan."
      }
    ]
  },
  "clients": [
    {
      "clientId": "agentic-iam-console",
      "name": "Agentic IAM Console",
      "description": "The human-facing console. Public client, Authorization Code + PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8000/*"
      },
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*",
        "http://localhost:8000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "http://localhost:8000",
        "+"
      ],
      "protocolMappers": [
        {
          "name": "agentic-iam-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "agentic-iam-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
